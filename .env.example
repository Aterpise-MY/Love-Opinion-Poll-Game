# Copy to .env and edit. docker compose reads .env from this folder at `up`.
#
# The key for /admin and /operator. Without a .env it falls back to `dev`,
# which is fine on your own laptop and not fine at an event: every phone in
# the room is on the same Wi-Fi as the operator console.
ADMIN_KEY=change-me

# The port on the laptop. Phones open http://<LAN address>:<this>/
HOST_PORT=8520
